@startuml fitness-mirror-sa-container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Styling approximations for Structurizr look
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam Handwritten false
skinparam Padding 2

' Container Diagram
title Container Diagram for Smart Fitness Mirror Platform

!define RECTANGLE class

Person(visitor, "Visitor", "Anonymous user who browses public website content and may sign up or apply as a coach.", $tags="Visitor")
Person(fitnessUser, "Fitness User", "Uses the Smart Fitness Mirror to train and track fitness progress.")
Person(fitnessCoach, "Fitness Coach", "Provides exercise and technique data for ML model training.")
Person(techSupport, "Technical Support Staff Member", "Monitors system performance and handles maintenance.")
Person(rndTeam, "R&D Team Member", "Analyzes trends and improves the platform.")
Person(platformOwner, "Platform Owner", "Approves high-level decisions and reviews business strategic analytics.")
Person(crmStaff, "Platform CRM Staff Member", "Manages subscriptions, equipment renting, and customer support.")
System_Ext(stripe, "Stripe", "Processes monthly/annual subscription and equipment renting payments.", $tags="External")
System_Ext(mirrorHardware, "Smart Mirror Hardware", "Physical device with camera, sensors, and display.", $tags="External,Hardware")

System_Boundary(smartFitnessPlatform, "Smart Fitness Mirror Platform") {
  Container(mobileApp, "Mobile App", "Swift/SwiftUI (iOS), Kotlin/Jetpack Compose (Android)", "Native app for training and analytics", $tags="MobileApp")
  Container(website, "Website", "TypeScript, Angular", "Serves public content", $tags="StaticContent")
  Container(webClientApp, "Web Client App", "TypeScript, Angular", "PWA for authenticated users", $tags="Browser")
  Container(apiGateway, "API Gateway", "AWS API Gateway", "Routes requests", $tags="Gateway")
  Container(embeddedApp, "Embedded App", "C++", "Controls mirror hardware", $tags="IoT")
  Container(edgeApp, "Edge App", "Python", "AI coaching and analytics", $tags="Edge")
  Container(edgeDB, "Edge Database", "SQLite", "Stores edge data", $tags="Database")
  Container(localFileSystem, "Fitness Local Station File System", "File System", "Stores media and ML models", $tags="FileSystem")
  Container(mobileDB, "Mobile Database", "SQLite", "Caches mobile data", $tags="Database")
  Container(iamService, "IAM Service", "Java, Spring Boot", "Commodity Bounded Context: Manages user identity and access.", $tags="Microservice,CommodityContext")
  Container(iamDB, "IAM Database", "PostgreSQL", "Stores credentials", $tags="Database")
  Container(performanceService, "Performance Service", "Java, Spring Boot", "Core Bounded Context: Manages real-time fitness performance data.", $tags="Microservice,CoreContext")
  Container(performanceDB, "Performance Database", "InfluxDB", "Stores performance data", $tags="Database")
  Container(trendsService, "Trends Service", "Java, Spring Boot", "Core Bounded Context: Manages exercise and technique trends.", $tags="Microservice,CoreContext")
  Container(trendsDB, "Trends Database", "InfluxDB", "Stores trends", $tags="Database")
  Container(subscriptionService, "Subscription Service", "Java, Spring Boot", "Supporting Bounded Context: Manages user subscriptions and billing.", $tags="Microservice,SupportingContext")
  Container(subscriptionDB, "Subscription Database", "Oracle", "Stores subscription data", $tags="Database")
  Container(analyticsService, "Analytics Service", "Java, Spring Boot", "Generic Bounded Context: Generates strategic business insights.", $tags="Microservice,GenericContext")
  Container(analyticsDB, "Analytics Database", "PostgreSQL (TimescaleDB)", "Stores analytics data", $tags="Database")
  Container(mediaService, "Media Service", "Java, Spring Boot", "Supporting Bounded Context: Manages video uploads and streaming.", $tags="Microservice,SupportingContext")
  Container(mediaStorage, "Media Storage", "Amazon S3", "Stores transcoded video files", $tags="Database")
  Container(cdn, "CDN", "CloudFront", "Delivers media content", $tags="StaticContent")
  Container(dataLake, "Data Lake", "Amazon S3", "Stores raw sensor and video data", $tags="Database")
  Container(modelTrainingService, "Model Training Service", "Python, PyTorch", "Core Bounded Context: Trains ML models.", $tags="Microservice,CoreContext")
  Container(modelRegistry, "Model Registry", "MLflow", "Stores and versions ML models", $tags="Database")
  Container(messageBroker, "Message Broker", "RabbitMQ", "Asynchronous messaging", $tags="MessageBroker")
}

Rel(visitor, website, "Requests the SPA route and receives the app shell for public content")
Rel(visitor, webClientApp, "Uses the Angular SPA after the app shell loads")
Rel(visitor, mobileApp, "Signs up or applies to become a user or coach via IAM")
Rel(fitnessUser, mobileApp, "Uses for training and reviews data")
Rel(fitnessUser, webClientApp, "Reviews analytics and manages account via domain-specific UI")
Rel(fitnessCoach, webClientApp, "Provides exercise/technique data via Coach Exercise UI")
Rel(techSupport, webClientApp, "Monitors platform health and performance via System Monitoring UI")
Rel(rndTeam, webClientApp, "Analyzes trends and manages model training for R&D via Trend Analysis and Model Training UIs")
Rel(platformOwner, webClientApp, "Reviews strategic business analytics via Strategic Analytics UI")
Rel(crmStaff, webClientApp, "Manages user subscriptions and customer support via Subscription Management UI")
Rel(crmStaff, stripe, "Initiates payment processing via Stripe ACL")
Rel(fitnessUser, mobileApp, "Authenticates and manages profile")
Rel(fitnessCoach, webClientApp, "Authenticates and manages profile")
Rel(techSupport, webClientApp, "Authenticates and manages profile")
Rel(rndTeam, webClientApp, "Authenticates and manages profile")
Rel(platformOwner, webClientApp, "Authenticates and manages profile")
Rel(crmStaff, webClientApp, "Authenticates and manages profile")
Rel(mobileApp, cdn, "Streams video content for review and training via Mobile Gateway Proxy")
Rel(webClientApp, cdn, "Streams video content for review and training")
Rel(platformOwner, stripe, "Oversees payment operations via Stripe ACL")
Rel(mobileApp, edgeApp, "Retrieves analytics, recommendations, and training plans via Mobile Gateway Proxy")
Rel(mobileApp, embeddedApp, "Controls group sessions")
Rel(mobileApp, mobileDB, "Caches and retrieves local data")
Rel(mobileApp, apiGateway, "Accesses cloud services and authenticates users")
Rel(website, apiGateway, "Handles sign-up and login requests via IAM")
Rel(website, webClientApp, "Delivers the Angular app shell and PWA assets to the browser app")
Rel(webClientApp, apiGateway, "Interacts with cloud services and authenticates users")
Rel(apiGateway, iamService, "Routes authentication, authorization, and identity requests")
Rel(apiGateway, performanceService, "Routes performance data")
Rel(apiGateway, trendsService, "Routes trends data")
Rel(apiGateway, subscriptionService, "Routes subscription requests")
Rel(apiGateway, analyticsService, "Routes analytics requests")
Rel(apiGateway, mediaService, "Routes media-related requests")
Rel(apiGateway, modelTrainingService, "Routes retraining job and model evaluation requests")
Rel(apiGateway, dataLake, "Ingests raw sensor and video data for AI R&D")
Rel(modelTrainingService, dataLake, "Fetches training data")
Rel(modelTrainingService, modelRegistry, "Registers trained models")
Rel(modelRegistry, edgeApp, "Deploys updated models to Edge")
Rel(modelRegistry, webClientApp, "Provides versioned models for evaluation via Model Training UI")
Rel(embeddedApp, mirrorHardware, "Controls and retrieves data from camera, sensors, and display via HAL [ACL]")
Rel(embeddedApp, edgeApp, "Sends session data and receives recommendations")
Rel(edgeApp, mirrorHardware, "Sends real-time coaching feedback and instructions")
Rel(edgeApp, edgeDB, "Stores and retrieves data and outbox")
Rel(edgeApp, localFileSystem, "Stores media recordings and ML models")
Rel(embeddedApp, localFileSystem, "Buffers session video recordings")
Rel(edgeApp, apiGateway, "Uploads session video recordings via Data Sync Orchestrator")
Rel(edgeApp, apiGateway, "Syncs anonymous summary data and trends reliably")
Rel(iamService, iamDB, "Stores and retrieves user credentials, roles, and tokens")
Rel(iamService, messageBroker, "Publishes UserRegistered events [Upstream]")
Rel(iamService, subscriptionService, "Links new users to subscriptions")
Rel(performanceService, performanceDB, "Stores and retrieves performance data via Training Session Aggregate")
Rel(trendsService, trendsDB, "Stores and retrieves trends data via Fitness Trend Aggregate")
Rel(subscriptionService, subscriptionDB, "Stores and retrieves subscription data")
Rel(subscriptionService, stripe, "Processes payments via Stripe ACL")
Rel(subscriptionService, messageBroker, "Publishes Subscription events [Upstream]")
Rel(analyticsService, analyticsDB, "Stores and retrieves analytics data")
Rel(trendsService, messageBroker, "Publishes TrendAnalyzed events [Upstream]")
Rel(performanceService, messageBroker, "Publishes WorkoutCompleted events [Upstream]")
Rel(mediaService, mediaStorage, "Stores transcoded videos")
Rel(mediaService, cdn, "Updates/Invalidates cached content")
Rel(mediaService, messageBroker, "Publishes VideoProcessed events [Upstream]")
Rel(messageBroker, analyticsService, "Delivers Trend, Performance, Subscription, and User events to Analytics [Downstream, Customer-Supplier]")

SHOW_LEGEND()
@enduml
